{
  "manifest_version": 2,
  "name": "Thunderbird CLI Enhanced",
  "version": "2.4.0",
  "description": "Connects Thunderbird to CLI agents via WebSocket bridge",
  "author": "thunderbird-cli-enhanced",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-cli-enhanced@odience.net",
      "strict_min_version": "128.0",
      "strict_max_version": "156.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Thunderbird CLI Enhanced — Connecting…"
  },
  "permissions": [
    "accountsRead",
    "accountsIdentities",
    "addressBooks",
    "compose",
    "compose.save",
    "compose.send",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesImport",
    "accountsFolders",
    "idle",
    "tabs"
  ],
  "background": {
    "scripts": ["src/access-config.js", "src/access-control.js", "src/thread-utils.js", "src/action-items.js", "src/calendar-clash.js", "src/background.js"]
  },
  "experiment_apis": {
    "calendar_calendars": {
      "schema": "experiments/calendar/schema/calendar-calendars.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-calendars.js",
        "paths": [["calendar", "calendars"]]
      }
    },
    "calendar_items": {
      "schema": "experiments/calendar/schema/calendar-items.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-items.js",
        "paths": [["calendar", "items"]]
      }
    },
    "calendar_tasks": {
      "schema": "experiments/calendar/schema/calendar-tasks.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-tasks.js",
        "paths": [["calendar", "tasks"]]
      }
    }
  }
}
