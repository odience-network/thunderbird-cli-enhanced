{
  "manifest_version": 2,
  "name": "Thunderbird CLI Enhanced",
  "version": "2.1.0",
  "description": "Connects Thunderbird to CLI agents via WebSocket bridge",
  "author": "thunderbird-cli-enhanced",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-cli-enhanced@odience.net",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "accountsRead",
    "accountsIdentities",
    "addressBooks",
    "compose",
    "compose.save",
    "compose.send",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesImport",
    "accountsFolders",
    "idle",
    "tabs"
  ],
  "background": {
    "scripts": ["src/access-config.js", "src/access-control.js", "src/thread-utils.js", "src/background.js"]
  }
}
