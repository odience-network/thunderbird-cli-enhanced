{
  "name": "thunderbird-cli",
  "version": "1.1.0",
  "description": "Low-level CLI + MCP server for AI agents to manage Mozilla Thunderbird email accounts.",
  "type": "module",
  "private": true,
  "workspaces": [
    "cli",
    "bridge",
    "mcp"
  ],
  "scripts": {
    "test": "node test/quick-test.mjs",
    "test:mcp": "node test/mcp-test.mjs",
    "test:mcp-concurrency": "node mcp/test/test_concurrency.mjs",
    "test:bridge-auth": "node test/bridge-auth.mjs",
    "test:bridge-security": "node test/bridge-security.mjs",
    "test:extension": "node test/thread-utils.test.mjs && node test/extension.test.mjs && node test/access-control.test.mjs && node test/draft-routing-test.mjs",
    "test:draft": "node test/draft-routing-test.mjs",
    "test:sign": "node test/sign-xpi.test.mjs",
    "test:docs": "node test/docs.test.mjs",
    "test:all": "npm test && npm run test:bridge-auth && npm run test:bridge-security && npm run test:extension && npm run test:sign && npm run test:docs && npm run test:mcp && npm run test:mcp-concurrency",
    "test:live-smoke": "node test/live-smoke.mjs",
    "test:live-attachment": "node test/live-attachment-smoke.mjs",
    "build:diagrams": "node scripts/build-diagrams.mjs",
    "lint": "node scripts/lint.mjs",
    "verify": "npm run build:xpi && npm run lint && npm run test:all",
    "bridge": "node bridge/bridge.js",
    "tb": "node cli/src/cli.js",
    "build:xpi": "node scripts/build-xpi.mjs",
    "sign:xpi": "node scripts/sign-xpi.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "anthropic",
    "thunderbird",
    "email",
    "email-client",
    "imap",
    "smtp",
    "cli",
    "ai-agent",
    "ai-tools",
    "agentic",
    "automation",
    "localhost",
    "privacy"
  ],
  "author": "Vitalii Ionov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/odience-network/thunderbird-cli-enhanced"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "ws": "^8.21.3"
  }
}
